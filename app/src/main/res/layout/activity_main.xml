<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="56dp"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:background="@color/surface"
            android:paddingHorizontal="16dp"
            android:elevation="4dp">
            <ImageView
                android:layout_width="36dp" android:layout_height="36dp"
                android:src="@mipmap/ic_launcher_round"
                android:contentDescription="Eleeth TV"/>
            <TextView
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="eleeth.com TV"
                android:textColor="@color/text"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium"/>
            <Button android:id="@+id/tipBtn"
                android:layout_width="wrap_content" android:layout_height="36dp"
                android:minWidth="80dp"
                android:text="Tip" android:textColor="#FFFFFF"
                android:textSize="13sp" android:textAllCaps="false"
                android:background="@drawable/btn_kofi"
                android:paddingHorizontal="14dp"/>
        </LinearLayout>

        <!-- VIDEO (single PlayerView, gets moved to fullscreen overlay) -->
        <FrameLayout
            android:id="@+id/videoContainer"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="#000000">
            <com.google.android.exoplayer2.ui.PlayerView android:id="@+id/playerView"
                android:layout_width="match_parent" android:layout_height="220dp"
                app:show_timeout="2500" app:use_controller="true"
                app:resize_mode="fit"/>
            <LinearLayout android:id="@+id/videoPlaceholder"
                android:layout_width="match_parent" android:layout_height="220dp"
                android:orientation="vertical" android:gravity="center"
                android:background="#0A0A10">
                <ImageView android:layout_width="56dp" android:layout_height="56dp"
                    android:src="@mipmap/ic_launcher_round" android:alpha="0.4"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Select a channel below to start watching"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"/>
            </LinearLayout>
            <ProgressBar android:id="@+id/loadingProgress"
                android:layout_width="48dp" android:layout_height="48dp"
                android:layout_gravity="center" android:visibility="gone"
                android:indeterminateTint="@color/accent"/>
        </FrameLayout>

        <!-- NOW PLAYING BAR -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:background="@color/card"
            android:paddingHorizontal="16dp" android:paddingVertical="12dp">
            <View android:layout_width="4dp" android:layout_height="32dp"
                android:background="@color/accent"/>
            <LinearLayout
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">
                <TextView android:id="@+id/nowPlayingName"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Nothing playing"
                    android:textColor="@color/text" android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:singleLine="true" android:ellipsize="end"/>
                <TextView android:id="@+id/nowPlayingGroup"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Pick a channel from the list"
                    android:textColor="@color/text_secondary" android:textSize="11sp"
                    android:singleLine="true" android:ellipsize="end"/>
            </LinearLayout>
            <Button android:id="@+id/fullscreenBtn"
                android:layout_width="40dp" android:layout_height="40dp"
                android:minWidth="0dp"
                android:contentDescription="Fullscreen"
                android:background="@drawable/btn_secondary"
                android:padding="8dp"
                android:layout_marginEnd="8dp"/>
            <Button android:id="@+id/stopBtn"
                android:layout_width="40dp" android:layout_height="40dp"
                android:minWidth="0dp"
                android:contentDescription="Stop"
                android:background="@drawable/btn_secondary"
                android:padding="8dp"/>
        </LinearLayout>

        <!-- SEARCH WITH CLEAR X BUTTON -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:background="@color/surface"
            android:paddingHorizontal="16dp" android:paddingTop="12dp">
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="44dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:background="@drawable/search_bg">
                <ImageView android:layout_width="18dp" android:layout_height="18dp"
                    android:src="@drawable/ic_search"/>
                <EditText android:id="@+id/searchInput"
                    android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:layout_marginStart="10dp"
                    android:background="@null"
                    android:textColor="@color/text" android:textColorHint="@color/text_secondary"
                    android:textSize="14sp" android:hint="Search channels by name or category"
                    android:imeOptions="actionSearch" android:inputType="text"
                    android:singleLine="true"/>
                <ImageButton android:id="@+id/clearSearchBtn"
                    android:layout_width="32dp" android:layout_height="32dp"
                    android:src="@drawable/ic_clear"
                    android:background="@drawable/btn_clear_selector"
                    android:scaleType="centerInside"
                    android:padding="6dp"
                    android:visibility="gone"
                    android:contentDescription="Clear search"/>
            </LinearLayout>
        </LinearLayout>

        <!-- CATEGORY CHIPS -->
        <HorizontalScrollView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:scrollbars="none"
            android:background="@color/surface"
            android:paddingVertical="10dp">
            <LinearLayout android:id="@+id/catScroll"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:paddingHorizontal="14dp"/>
        </HorizontalScrollView>

        <!-- RESULTS COUNT -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingHorizontal="16dp" android:paddingVertical="10dp">
            <TextView android:id="@+id/channelCount"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/text_secondary" android:textSize="12sp"
                tools:text="13274 channels"/>
        </LinearLayout>

        <!-- CHANNEL GRID -->
        <FrameLayout
            android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1">
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/channelList"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="10dp" android:paddingBottom="10dp"/>
            <TextView android:id="@+id/emptyView"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="No channels match"
                android:textColor="@color/text_secondary" android:textSize="14sp"
                android:visibility="gone"/>
        </FrameLayout>

    </LinearLayout>

    <!-- FULLSCREEN OVERLAY: receives the PlayerView when entered -->
    <FrameLayout android:id="@+id/fullscreenOverlay"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone"
        android:clickable="true" android:focusable="true">
        <Button android:id="@+id/exitFullscreenBtn"
            android:layout_width="44dp" android:layout_height="44dp"
            android:layout_gravity="top|end" android:layout_margin="16dp"
            android:minWidth="0dp"
            android:contentDescription="Exit fullscreen"
            android:background="#A0000000"
            android:padding="10dp"/>
    </FrameLayout>

</FrameLayout>
