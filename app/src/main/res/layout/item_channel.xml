<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/card" app:cardCornerRadius="10dp"
    app:cardElevation="1dp"
    android:foreground="?attr/selectableItemBackground">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center"
        android:padding="10dp">
        <ImageView android:id="@+id/chLogo"
            android:layout_width="52dp" android:layout_height="52dp"
            android:src="@android:color/darker_gray"
            android:scaleType="centerCrop"
            android:background="@drawable/ch_logo_bg"/>
        <TextView android:id="@+id/chName"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text"
            android:textSize="12sp"
            android:maxLines="2" android:ellipsize="end"
            android:gravity="center"/>
        <TextView android:id="@+id/chGroup"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/accent"
            android:textSize="10sp"
            android:maxLines="1" android:ellipsize="end"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>